DATABASE_URL=postgresql://postgres:postgres@localhost:5432/shgconnect
PORT=4000

# SMS Gateway Configuration
# Options: DEV_SIMULATOR | TWILIO | FAST2SMS
SMS_PROVIDER=DEV_SIMULATOR

# Twilio Credentials (Required if SMS_PROVIDER=TWILIO)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+1xxxxxxxxxx

# Fast2SMS Credentials (Required if SMS_PROVIDER=FAST2SMS)
# SMS_API_KEY=your_fast2sms_api_key_here
